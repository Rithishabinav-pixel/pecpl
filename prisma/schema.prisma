generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum FormType {
  CONTACT
  REQUEST_QUOTE
}

model ContactEnquiry {
  id        String    @id @default(cuid())
  name      String
  phone     String
  email     String
  location  String
  message   String?
  formType  FormType
  createdAt DateTime  @default(now())
}

model NewsletterSubscription {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model CareerApplication {
  id         String   @id @default(cuid())
  name       String
  phone      String
  email      String
  location   String
  position   String
  message    String?
  resumePath String
  resumeName String
  createdAt  DateTime @default(now())
}
